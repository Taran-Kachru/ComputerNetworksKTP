# Makefile.lib - builds the static library libksocket.a with ar.
CXX      = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2
AR       = ar

all: libksocket.a

ksocket.o: ksocket.cpp ksocket.h ktp_internal.h
	$(CXX) $(CXXFLAGS) -c ksocket.cpp -o ksocket.o

libksocket.a: ksocket.o
	$(AR) rcs libksocket.a ksocket.o

clean:
	rm -f ksocket.o libksocket.a

.PHONY: all clean
