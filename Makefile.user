# Makefile.user - builds the two test executables user1 and user2.
CXX      = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2
LDLIBS   = -L. -lksocket -pthread -lrt

all: user1 user2

libksocket.a:
	$(MAKE) -f Makefile.lib

user1: user1.cpp libksocket.a ksocket.h
	$(CXX) $(CXXFLAGS) user1.cpp -o user1 $(LDLIBS)

user2: user2.cpp libksocket.a ksocket.h
	$(CXX) $(CXXFLAGS) user2.cpp -o user2 $(LDLIBS)

clean:
	rm -f user1 user2

.PHONY: all clean
