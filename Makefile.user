# Makefile.user - builds the two test executables user1 and user2.
CC       = gcc
CFLAGS   = -std=c11 -Wall -Wextra -O2 -D_GNU_SOURCE
LDLIBS   = -L. -lksocket -pthread -lrt

all: user1 user2

libksocket.a:
	$(MAKE) -f Makefile.lib

user1: user1.c libksocket.a ksocket.h
	$(CC) $(CFLAGS) user1.c -o user1 $(LDLIBS)

user2: user2.c libksocket.a ksocket.h
	$(CC) $(CFLAGS) user2.c -o user2 $(LDLIBS)

clean:
	rm -f user1 user2

.PHONY: all clean
